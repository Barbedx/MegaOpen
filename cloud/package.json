{
  "name": "megaopen-cloud",
  "version": "1.0.0",
  "private": true,
  "description": "MegaOpen ESP32 log storage + OTA backend (Cloudflare Worker, D1 + KV)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "db:local": "wrangler d1 execute megaopen --local --file schema.sql",
    "db:remote": "wrangler d1 execute megaopen --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
